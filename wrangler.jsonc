{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chi-tieu",
  "main": "worker/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chi-tieu-db",
      "database_id": "e6a504c3-4ff7-417d-9970-437376d6413d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://chi-tieu.hieutrantaskflow.workers.dev"
  }
}
